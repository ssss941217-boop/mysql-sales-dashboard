    let cCat = null, cReg = null;

    const catSelect = document.getElementById('filter-cat');
    const regSelect = document.getElementById('filter-reg');
    const searchInput = document.getElementById('filter-search');

    [...new Set(data.map(r => r.product_category))].sort().forEach(c => {
      const opt = document.createElement('option'); opt.value = c; opt.textContent = c; catSelect.appendChild(opt);
    });
    [...new Set(data.map(r => r.region))].sort().forEach(r => {
      const opt = document.createElement('option'); opt.value = r; opt.textContent = r; regSelect.appendChild(opt);
    });

    function filterData() {
      const c = catSelect.value, r = regSelect.value, q = searchInput.value.toLowerCase().trim();
      const filtered = data.filter(d => {
        if (c && d.product_category !== c) return false;
        if (r && d.region !== r) return false;
        if (q && !(d.product_name.toLowerCase().includes(q) || d.customer_name.toLowerCase().includes(q))) return false;
        return true;
      });

      const rev = filtered.reduce((s, d) => s + d.total_amount, 0);
      const items = filtered.reduce((s, d) => s + d.quantity, 0);
      document.getElementById('kpi-rev').innerText = 'NT$ ' + rev.toLocaleString();
      document.getElementById('kpi-orders').innerText = filtered.length.toLocaleString() + ' 筆';
      document.getElementById('kpi-aov').innerText = 'NT$ ' + (filtered.length ? Math.round(rev/filtered.length).toLocaleString() : 0);
      document.getElementById('kpi-items').innerText = items.toLocaleString() + ' 件';
      document.getElementById('table-count').innerText = filtered.length;

      document.getElementById('table-body').innerHTML = filtered.slice(0, 100).map(d => `
        <tr class="hover:bg-slate-800/50">
          <td class="p-3">#${d.transaction_id}</td>
          <td class="p-3">${d.order_date}</td>
          <td class="p-3">${d.customer_name}</td>
          <td class="p-3">${d.product_category}</td>
          <td class="p-3 text-white font-medium">${d.product_name}</td>
          <td class="p-3">${d.quantity}</td>
          <td class="p-3">NT$ ${d.unit_price.toLocaleString()}</td>
          <td class="p-3 text-indigo-400 font-bold">NT$ ${d.total_amount.toLocaleString()}</td>
          <td class="p-3">${d.region}</td>
          <td class="p-3 text-emerald-400">${d.order_status}</td>
        </tr>
      `).join('');

      renderCharts(filtered);
    }

    function renderCharts(dList) {
      const catMap = {}, regMap = {};
      dList.forEach(d => {
        catMap[d.product_category] = (catMap[d.product_category] || 0) + d.total_amount;
        regMap[d.region] = (regMap[d.region] || 0) + d.total_amount;
      });

      if (cCat) cCat.destroy();
      cCat = new Chart(document.getElementById('chart-cat'), {
        type: 'bar',
        data: {
          labels: Object.keys(catMap),
          datasets: [{ label: '營收 (NT$)', data: Object.values(catMap), backgroundColor: '#4f46e5', borderRadius: 6 }]
        },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
      });

      if (cReg) cReg.destroy();
      cReg = new Chart(document.getElementById('chart-reg'), {
        type: 'doughnut',
        data: {
          labels: Object.keys(regMap),
          datasets: [{ data: Object.values(regMap), backgroundColor: ['#0ea5e9', '#10b981', '#f59e0b', '#8b5cf6'] }]
        },
        options: { responsive: true, maintainAspectRatio: false }
      });
    }

    filterData();
